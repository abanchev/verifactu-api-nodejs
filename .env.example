# Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_NAME=verifactu
MYSQL_USER=verifactu
MYSQL_PASS=your_password_here
TIMEZONE=Europe/Madrid

# Certificate Content (PEM format)
# Extract from your .p12 certificate:
#   openssl pkcs12 -in cert.p12 -nocerts -nodes -out key.pem
#   openssl pkcs12 -in cert.p12 -clcerts -nokeys -out cert.pem
# Then paste the content here (use quotes for multiline in docker-compose)
KEY_CONTENT="-----BEGIN PRIVATE KEY-----
YOUR_PRIVATE_KEY_CONTENT_HERE
-----END PRIVATE KEY-----"

CERT_CONTENT="-----BEGIN CERTIFICATE-----
YOUR_CERTIFICATE_CONTENT_HERE
-----END CERTIFICATE-----"

# Software Info (your company as the software developer)
SOFTWARE_COMPANY_NAME=Your Company Name
SOFTWARE_COMPANY_NIF=B12345678
SOFTWARE_NAME=verifactu
SOFTWARE_ID=vf
SOFTWARE_VERSION=1.0
SOFTWARE_INSTALL_NUMBER=00001

# Server Configuration
BACKEND_URL=http://0.0.0.0:8023
# BACKEND_TOKEN will be auto-generated if not provided
# BACKEND_TOKEN=your_secure_token_here

# Optional: Restrict access to specific IP
# ALLOW_IP=192.168.1.100

# Auto-process interval in seconds (default: 60, set to 0 to disable)
PROCESS_INTERVAL=60
